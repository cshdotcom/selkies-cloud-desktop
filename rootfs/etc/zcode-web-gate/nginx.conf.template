# =============================================================================
# zcode-web-gate nginx 配置模板
# 由 /etc/service/zcode-web-gate/run 在每次启动时按当前环境实例化：
#   @RUNTIME@     → 运行时目录（${XDG_RUNTIME_DIR}/zcode-web-gate）
#   @LISTEN_PORT@ → 对外监听端口（ZCODE_WEB_PORT，默认 8081）
#   @TOKEN@       → zcode 内层认证 token（随机生成，注入为 Bearer 头）
# 生成结果：${XDG_RUNTIME_DIR}/zcode-web-gate/nginx.conf
#
# 设计要点：
#   - 无 user 指令 / 临时目录与 pid 全在运行时目录 → 容器内非 root 可运行
#   - auth_basic + htpasswd（bcrypt）→ 浏览器弹窗输入用户名+密码
#   - map + Upgrade/Connection 头透传 → WebSocket（zcode 的 /ws）
#   - 注入 Authorization: Bearer → zcode 内层 token 认证（用户无感知）
#   - 读/写超时 1 小时 + 关缓冲 → 流式对话与长连接
# =============================================================================
worker_processes 1;
error_log /dev/stderr warn;
pid @RUNTIME@/nginx.pid;

events {
    worker_connections 256;
}

http {
    server_tokens off;
    default_type application/octet-stream;
    access_log /dev/stdout;

    # zcode --web 的附件/文档上传
    client_max_body_size 512m;

    # 临时目录全部落在运行时目录（容器内非 root 亦可写）
    client_body_temp_path @RUNTIME@/nginx/client_body;
    proxy_temp_path      @RUNTIME@/nginx/proxy;
    fastcgi_temp_path    @RUNTIME@/nginx/fastcgi;
    uwsgi_temp_path      @RUNTIME@/nginx/uwsgi;
    scgi_temp_path       @RUNTIME@/nginx/scgi;

    # WebSocket 升级支持（zcode --web 的 /ws 长连接）
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen @LISTEN_PORT@;
        server_name _;

        # —— 登录闸门：浏览器弹窗输入用户名 + 密码 ——
        auth_basic "ZCode Web";
        auth_basic_user_file @RUNTIME@/zcode-web.htpasswd;

        location / {
            proxy_pass http://127.0.0.1:3030;
            proxy_http_version 1.1;

            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # WebSocket 升级透传
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # —— 内层认证：注入 Bearer token（zcode 服务端校验，用户无感知） ——
            proxy_set_header Authorization "Bearer @TOKEN@";

            # 流式对话 / WebSocket 长连接
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }
    }
}
