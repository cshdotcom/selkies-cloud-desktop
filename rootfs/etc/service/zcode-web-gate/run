#!/bin/bash
# =============================================================================
# s6 服务：ZCode Web 认证网关（nginx，对外端口 8081）
#
#     浏览器 ──BasicAuth 用户名+密码──▶ nginx :8081 ──Bearer token──▶ 127.0.0.1:3030
#
# 登录凭据解析顺序（默认与桌面端一套密码走天下，也可单独指定）：
#     用户名: ZCODE_WEB_USER       → SELKIES_BASIC_AUTH_USER → admin
#     密  码: ZCODE_WEB_PASSWORD   → SELKIES_BASIC_AUTH_PASSWORD
#
# - 未配置任何密码时网关停靠（8081 拒绝放行任何流量，杜绝无密码裸奔）；
# - 网关自动向 zcode 注入 Bearer token（由 zcode-web 服务随机生成），
#   用户无需感知 token —— BasicAuth 之外的第二层防护；
# - htpasswd 与 nginx 配置均在每次启动时按当前环境重新生成，
#   修改密码后重启容器即生效。
# =============================================================================
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"

# 等待 container-entrypoint.sh 写入的共享会话环境（与 desktop 服务同一模式）
until [ -f "${XDG_RUNTIME_DIR}/container-env" ]; do sleep 0.5; done
# shellcheck disable=SC1091  # 由 container-entrypoint.sh 在启动时生成
. "${XDG_RUNTIME_DIR}/container-env"

LISTEN_PORT="${ZCODE_WEB_PORT:-8081}"
AUTH_USER="${ZCODE_WEB_USER:-${SELKIES_BASIC_AUTH_USER:-admin}}"
AUTH_PASS="${ZCODE_WEB_PASSWORD:-${SELKIES_BASIC_AUTH_PASSWORD:-}}"

if [ -z "${AUTH_PASS}" ]; then
  echo "[zcode-web-gate] WARN: ZCODE_WEB_PASSWORD / SELKIES_BASIC_AUTH_PASSWORD 均未设置"
  echo "[zcode-web-gate] 网关停靠：端口 ${LISTEN_PORT} 不对外放行（避免无密码暴露）"
  exec sleep infinity
fi

# 等 zcode-web 服务生成共享 token（Bearer 注入用）
until [ -s "${XDG_RUNTIME_DIR}/zcode-web-token" ]; do sleep 0.5; done
ZCODE_WEB_TOKEN="$(cat "${XDG_RUNTIME_DIR}/zcode-web-token")"

RUN_DIR="${XDG_RUNTIME_DIR}/zcode-web-gate"
mkdir -p "${RUN_DIR}/nginx"

# ---- 1) 生成 htpasswd：bcrypt 优先（apache2-utils），openssl apr1 兜底 ----
HTPASSWD="${RUN_DIR}/zcode-web.htpasswd"
if printf '%s\n' "${AUTH_PASS}" | htpasswd -iB -c "${HTPASSWD}" "${AUTH_USER}" >/dev/null 2>&1; then
  :
elif command -v openssl >/dev/null 2>&1 && \
     printf '%s:%s\n' "${AUTH_USER}" "$(openssl passwd -apr1 "${AUTH_PASS}")" > "${HTPASSWD}"; then
  :
else
  echo "[zcode-web-gate] FATAL: htpasswd 与 openssl 均不可用，拒绝无认证运行，网关停靠"
  exec sleep infinity
fi
chmod 600 "${HTPASSWD}" 2>/dev/null || true

# ---- 2) 按当前环境实例化 nginx 配置（python3 字面替换，杜绝配置注入） ----
NGINX_BIN="$(command -v nginx || true)"
[ -n "${NGINX_BIN}" ] || NGINX_BIN="/usr/sbin/nginx"
NGINX_CONF="${RUN_DIR}/nginx.conf"
python3 - /etc/zcode-web-gate/nginx.conf.template "${NGINX_CONF}" \
    "${RUN_DIR}" "${LISTEN_PORT}" "${ZCODE_WEB_TOKEN}" <<'PYEOF'
import sys

tpl_path, out_path, runtime_dir, listen_port, token = sys.argv[1:6]
with open(tpl_path, encoding="utf-8") as fh:
    conf = fh.read()
conf = (conf.replace("@RUNTIME@", runtime_dir)
            .replace("@LISTEN_PORT@", listen_port)
            .replace("@TOKEN@", token))
with open(out_path, "w", encoding="utf-8") as fh:
    fh.write(conf)
PYEOF
if [ ! -s "${NGINX_CONF}" ]; then
  echo "[zcode-web-gate] FATAL: 无法生成 nginx 配置，网关停靠"
  exec sleep infinity
fi
chmod 600 "${NGINX_CONF}" 2>/dev/null || true

echo "[zcode-web-gate] auth gate listening on :${LISTEN_PORT} -> 127.0.0.1:3030 (user: ${AUTH_USER})"
exec "${NGINX_BIN}" -c "${NGINX_CONF}" -g "daemon off;"
