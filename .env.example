# =============================================================================
# .env.example —— docker compose 部署的环境变量样例
#   cp .env.example .env && 按需修改，然后 docker compose up -d
# =============================================================================

# —— 必填：Web 登录密码（浏览器 BasicAuth 弹窗里配合用户名一起输入）——
SELKIES_BASIC_AUTH_PASSWORD=please-change-me

# Web 登录用户名（默认 admin）
SELKIES_BASIC_AUTH_USER=admin

# 可选：只读观看密码。设置后，用它登录的同事只能观看不能操作；
# 不设置则所有登录者均拥有完整键鼠控制权限。
#SELKIES_BASIC_AUTH_VIEWONLY_PASSWORD=

# 可选：容器内桌面账户密码（sudo 提权时使用）
#PASSWD=please-change-me-too

# 可选：时区
TZ=Asia/Shanghai

# 可选：流参数（默认按 2G 内存优化：30fps、6Mbps）
#SELKIES_FRAMERATE=30,8-60
#SELKIES_VIDEO_BITRATE=6000,1000-16000

# 可选：初始分辨率（客户端连上后随浏览器自适应）
#DISPLAY_SIZEW=1600
#DISPLAY_SIZEH=900
